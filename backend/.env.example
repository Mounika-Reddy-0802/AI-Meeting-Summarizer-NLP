# Backend environment template - names only, never real values.
# Copy to backend/.env and fill it in locally. backend/.env is gitignored.

# secret used to sign login tokens
JWT_SECRET=
# sqlite connection string; keep the database file outside git
DATABASE_URL=
# folder that holds every downloaded model
MODEL_DIR=
# faster-whisper model size
WHISPER_SIZE=
# hugging face read token, used only by scripts/download_models.py for pyannote; the app never reads it
HF_TOKEN=
